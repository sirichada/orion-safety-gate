=== script ===
(function(){
  function setText(el, text){ try { el.textContent = text; } catch(e){} }
  document.querySelectorAll('button[data-copy]').forEach(function(b){
    b.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var label = b.textContent;
      try {
        navigator.clipboard.writeText(b.getAttribute('data-copy')).then(
          function(){ setText(b, {{copied}}); setTimeout(function(){ setText(b, label); }, 1500); },
          function(){ setText(b, {{select_copy}}); });
      } catch(err){ setText(b, {{select_copy}}); }
    });
  });
  document.querySelectorAll('[data-review-case]').forEach(function(box){
    var form = box.querySelector('form.rform');
    if (!form) { return; }
    var button = form.querySelector('.rdownload');
    var status = form.querySelector('.rstatus');
    function collect(){
      var items = form.querySelectorAll('.ritem');
      var judgements = [], harmful = 0, judged = 0;
      items.forEach(function(item, i){
        var picked = form.querySelector('input[name="j' + i + '"]:checked');
        if (picked) { judged += 1; var h = picked.value === 'harmful'; if (h) { harmful += 1; } judgements.push({id: item.getAttribute('data-id'), harmful: h}); }
      });
      return {items: items.length, judged: judged, harmful: harmful, judgements: judgements};
    }
    function refresh(){
      var c = collect();
      var text = button.getAttribute('data-totals').replace('{judged}', c.judged).replace('{n}', c.items).replace('{harmful}', c.harmful);
      setText(status, text);
    }
    form.addEventListener('change', refresh);
    refresh();
    button.addEventListener('click', function(){
      var c = collect();
      var reviewer = form.elements['reviewer'].value.trim();
      var date = form.elements['date'].value.trim();
      var decision = form.elements['decision'].value;
      if (c.judged !== c.items || !reviewer || !date || !decision) { setText(status, button.getAttribute('data-incomplete')); return; }
      var payload = {case_id: box.getAttribute('data-review-case'), reviewer: reviewer, date: date, n_reviewed: c.judged, n_judged_harmful: c.harmful, decision: decision, note: form.elements['note'].value, judgements: c.judgements};
      try {
        var blob = new Blob([JSON.stringify(payload, null, 2) + '\n'], {type: 'application/json'});
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url; a.download = 'review.json';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        setTimeout(function(){ try { URL.revokeObjectURL(url); } catch(e){} }, 1000);
      } catch(err){ setText(status, {{select_copy}}); }
    });
  });
})();
