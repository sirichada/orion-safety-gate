=== css ===
/* Layout: one reading column. A full-width verdict band coloured by outcome, two gate tiles, then one row per case with a gauge, each row opening in place. Colour is spent only on status. */
:root {
  --bg: #f3f5f8; --surface: #ffffff; --fg: #141b26; --muted: #586579; --line: #d8dee7; --soft: #eaeef4;
  --accent: #2456a6;
  --ok: #157046; --ok-bg: #dff3e7; --ok-strong: #1c8a57;
  --warn: #8a5200; --warn-bg: #fdefd2; --warn-strong: #d38a12;
  --bad: #a8231b; --bad-bg: #fbe2df; --bad-strong: #c9362c;
  --rev: #6a3fb0; --rev-bg: #ece4fb; --rev-strong: #7d4fd0;
  --na: #5c6878; --na-bg: #e7ebf0;
  --on-strong: #ffffff;
  --sans: "IBM Plex Sans Thai", system-ui, -apple-system, "Segoe UI", "Noto Sans Thai", sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0f141b; --surface: #171e28; --fg: #e6ebf2; --muted: #9ca8b8; --line: #2c3645; --soft: #1f2733;
    --accent: #79a8f0;
    --ok: #62cf95; --ok-bg: #14301f; --ok-strong: #1f7a4c;
    --warn: #f0b24a; --warn-bg: #3a2c10; --warn-strong: #b0720c;
    --bad: #f38a80; --bad-bg: #3d1b19; --bad-strong: #b5322a;
    --rev: #c0a3f5; --rev-bg: #2c2140; --rev-strong: #6c46b8;
    --na: #9aa6b6; --na-bg: #242c38;
    --on-strong: #ffffff;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0f141b; --surface: #171e28; --fg: #e6ebf2; --muted: #9ca8b8; --line: #2c3645; --soft: #1f2733;
  --accent: #79a8f0;
  --ok: #62cf95; --ok-bg: #14301f; --ok-strong: #1f7a4c;
  --warn: #f0b24a; --warn-bg: #3a2c10; --warn-strong: #b0720c;
  --bad: #f38a80; --bad-bg: #3d1b19; --bad-strong: #b5322a;
  --rev: #c0a3f5; --rev-bg: #2c2140; --rev-strong: #6c46b8;
  --na: #9aa6b6; --na-bg: #242c38;
  --on-strong: #ffffff;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body { background: var(--bg); color: var(--fg); font-family: var(--sans); font-size: 15px; line-height: 1.55;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 24px 64px; }
main { max-width: 940px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }
h1 { font-size: 1.9rem; line-height: 1.2; margin: 0; font-weight: 700; text-wrap: balance; }
h2 { font-size: 1.1rem; margin: 0; font-weight: 600; }
.num { font-family: var(--mono); font-variant-numeric: tabular-nums; }
.top { display: flex; flex-direction: column; gap: 6px; }
.top .kind { color: var(--muted); font-size: .9rem; margin: 0; }
.meta { display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--muted); font-size: .86rem; margin: 0; padding: 0; list-style: none; }
.meta b { color: var(--fg); font-weight: 500; }

/* Verdict band */
.band { border-radius: 12px; padding: 20px 22px; color: var(--on-strong); display: grid; grid-template-columns: 1fr auto; gap: 8px 20px; align-items: center; }
.band.admit { background: var(--ok-strong); }
.band.reject { background: var(--bad-strong); }
.band .label { font-size: .95rem; opacity: .9; margin: 0; }
.band .word { font-size: 2.3rem; font-weight: 700; line-height: 1.1; margin: 0; }
.band .why { grid-column: 1 / -1; margin: 0; font-size: .95rem; }
.band .stamp { border: 2px solid currentColor; border-radius: 8px; padding: 6px 12px; font-weight: 600; font-size: .9rem; text-align: center; }

.gates { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
.gate { border-radius: 10px; padding: 14px 16px; border: 1px solid var(--line); background: var(--surface); display: flex; flex-direction: column; gap: 4px; border-left: 6px solid var(--line); }
.gate.pass { border-left-color: var(--ok-strong); }
.gate.fail { border-left-color: var(--bad-strong); }
.gate.insufficient { border-left-color: var(--warn-strong); }
.gate .head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
.gate p { margin: 0; color: var(--muted); font-size: .9rem; }

.pill { display: inline-flex; align-items: center; gap: 5px; font-size: .8rem; font-weight: 600; padding: 2px 10px; border-radius: 999px; white-space: nowrap; }
.pill::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
.pill.pass { background: var(--ok-bg); color: var(--ok); }
.pill.fail { background: var(--bad-bg); color: var(--bad); }
.pill.insufficient { background: var(--warn-bg); color: var(--warn); }
.pill.review { background: var(--rev-bg); color: var(--rev); }
.pill.na { background: var(--na-bg); color: var(--na); }

.notice { border-radius: 10px; padding: 14px 16px; background: var(--warn-bg); border: 1px solid var(--warn-strong); display: flex; flex-direction: column; gap: 8px; }
.notice h2 { color: var(--warn); }
.notice ul { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: 6px; }
.notice p { margin: 0; }

.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 16px 0 6px; min-width: 0; }
.panel > h2, .panel > .sub { padding: 0 18px; }
.panel > .sub { color: var(--muted); font-size: .88rem; margin: 2px 0 10px; }
.gatehead { padding: 10px 18px 6px; font-size: .85rem; color: var(--muted); font-weight: 600; border-top: 1px solid var(--line); margin-top: 6px; }

/* Case rows */
details.case { border-top: 1px solid var(--line); }
details.case > summary { list-style: none; cursor: pointer; padding: 12px 18px 12px 14px; display: grid;
  grid-template-columns: 6px minmax(0, 1.4fr) minmax(150px, 1fr) auto auto; gap: 4px 16px; align-items: center; }
details.case > summary::-webkit-details-marker { display: none; }
details.case > summary:hover { background: var(--soft); }
details.case > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.stripe { align-self: stretch; border-radius: 3px; background: var(--line); }
.case.pass .stripe { background: var(--ok-strong); }
.case.fail .stripe { background: var(--bad-strong); }
.case.insufficient .stripe { background: var(--warn-strong); }
.case.review .stripe { background: var(--rev-strong); }
.case.fail > summary { background: var(--bad-bg); }
.case.insufficient > summary { background: var(--warn-bg); }
.case.review > summary { background: var(--rev-bg); }
.name { display: flex; flex-direction: column; min-width: 0; }
.name b { font-weight: 600; }
.name span { color: var(--muted); font-size: .84rem; }
.flag { color: var(--warn); font-weight: 600; }
.score { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.score .vals { font-size: .86rem; display: flex; justify-content: space-between; gap: 8px; }
.score .vals .mark { color: var(--muted); }
.gauge { position: relative; height: 10px; border-radius: 5px; background: var(--soft); overflow: hidden; }
details.case > summary:hover .gauge { background: var(--line); }
.gauge .zone { position: absolute; top: 0; bottom: 0; background: var(--ok-bg); }
.gauge .tick { position: absolute; top: -2px; bottom: -2px; width: 2px; background: var(--fg); opacity: .55; }
.gauge .fleet { position: absolute; top: 3px; bottom: 3px; min-width: 3px; background: var(--muted); opacity: .45; border-radius: 2px; }
.score .fleetline { font-size: .8rem; color: var(--muted); }
.gauge .dot { position: absolute; top: 1px; width: 8px; height: 8px; margin-left: -4px; border-radius: 50%; background: var(--fg); }
.toggle { color: var(--accent); font-size: .86rem; font-weight: 500; white-space: nowrap; display: inline-flex; align-items: center; gap: 4px; }
.toggle::after { content: ""; width: 7px; height: 7px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg) translateY(-2px); transition: transform .15s; }
details[open] > summary .toggle::after { transform: rotate(-135deg) translate(-2px, 0); }
details[open] > summary .toggle .o { display: none; }
details:not([open]) > summary .toggle .c { display: none; }
@media (prefers-reduced-motion: reduce) { .toggle::after { transition: none; } }

.detail { padding: 6px 18px 18px 34px; display: flex; flex-direction: column; gap: 12px; }
.facts { display: grid; grid-template-columns: max-content 1fr; gap: 3px 16px; font-size: .88rem; margin: 0; }
.facts dt { color: var(--muted); }
.facts dd { margin: 0; }
.samples-h { font-size: .9rem; font-weight: 600; margin: 4px 0 0; }
.sample { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; font-size: .88rem; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.sample .id { font-family: var(--mono); font-size: .78rem; color: var(--muted); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.sample pre { margin: 0; white-space: pre-wrap; word-break: break-word; font-family: var(--sans); font-size: .9rem; background: var(--soft); padding: 8px 10px; border-radius: 6px; }
.sample mark { background: var(--warn-bg); color: inherit; outline: 1px solid var(--warn-strong); padding: 0 2px; border-radius: 2px; }
.review-box { border: 1px solid var(--rev-strong); background: var(--rev-bg); border-radius: 8px; padding: 10px 12px; font-size: .88rem; display: flex; flex-direction: column; gap: 4px; }
.review-box b { color: var(--rev); }
.reasons { margin: 0; padding-left: 1.1em; font-size: .88rem; }
.mini { border-collapse: collapse; font-size: .88rem; }
.mini td, .mini th { padding: 4px 18px 4px 0; text-align: left; }
.mini th { color: var(--muted); font-weight: 500; }

.untested { padding: 12px 18px; border-top: 1px solid var(--line); display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; font-size: .9rem; }
.untested b { font-weight: 600; }
.foot-note { padding: 10px 18px 8px; border-top: 1px solid var(--line); color: var(--muted); font-size: .85rem; margin: 0; }

.settings { display: grid; grid-template-columns: max-content 1fr; gap: 4px 18px; font-size: .9rem; margin: 0; padding: 0 18px 12px; }
.settings dt { color: var(--muted); }
.settings dd { margin: 0; overflow-wrap: anywhere; }
footer { color: var(--muted); font-size: .84rem; }

@media (max-width: 640px) {
  details.case > summary { grid-template-columns: 6px minmax(0, 1fr) auto; }
  details.case > summary .score { grid-column: 2 / -1; }
  details.case > summary .st { grid-column: 3; grid-row: 1; }
  details.case > summary .toggle { grid-column: 2 / -1; }
  .detail { padding-left: 18px; }
  .band .word { font-size: 1.9rem; }
}

.change { border-radius: 10px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--accent); display: flex; flex-direction: column; gap: 8px; }
.change ul { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: 4px; }
.change .from { color: var(--muted); text-decoration: line-through; }
div.grp { border: 1px solid var(--line); border-radius: 8px; padding-bottom: 8px; }
p.grp-h { margin: 0; padding: 8px 12px; display: flex; justify-content: space-between; font-weight: 600; font-size: .9rem; }
details.more { padding: 4px 12px 0; }
details.more > ul.fails { padding: 6px 0 0; }
details.grp > summary { cursor: pointer; padding: 8px 12px; display: flex; justify-content: space-between; font-weight: 600; font-size: .9rem; }
details.grp > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
ul.fails { list-style: none; margin: 0; padding: 0 12px 10px; display: flex; flex-direction: column; gap: 6px; font-size: .86rem; }
ul.fails li { display: flex; flex-direction: column; gap: 1px; border-top: 1px solid var(--line); padding-top: 6px; min-width: 0; }
ul.fails .id { font-family: var(--mono); font-size: .78rem; color: var(--muted); }
ul.fails .ex { overflow-wrap: anywhere; }
details.reveal > summary { cursor: pointer; color: var(--accent); font-size: .86rem; }
details.reveal p { margin: 6px 0 0; color: var(--muted); font-size: .86rem; font-style: italic; }

.tag { font-family: var(--sans); font-size: .76rem; color: var(--muted); background: var(--soft); border-radius: 4px; padding: 1px 6px; }
.q { font-size: .92rem; }
ol.opts { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 3px; font-size: .88rem; }
ol.opts li { padding: 3px 8px; border-radius: 4px; border: 1px solid transparent; }
ol.opts li.ans { background: var(--ok-bg); border-color: var(--ok-strong); }
ol.opts li.pick { background: var(--bad-bg); border-color: var(--bad-strong); }
table.cats { width: 100%; }
table.cats .r { text-align: right; }
table.cats td, table.cats th { border-top: 1px solid var(--line); padding: 4px 10px 4px 0; }
.legend{margin:0;color:var(--muted);font-size:.85rem}
.band.undecided { background: var(--warn-strong); }
.band.review_needed { background: var(--rev-strong); }
.band.admitted_after_review { background: var(--ok-strong); }
.band.not_admitted { background: var(--bad-strong); }
.band.not_decided { background: var(--warn-strong); }
.band.admitted { background: var(--ok-strong); }
.gate.review, .gate.needs_review { border-left-color: var(--rev-strong); }
.gate.insufficient_data { border-left-color: var(--warn-strong); }
.gate.not_testable { border-left-color: var(--na); }
.pill.needs_review { background: var(--rev-bg); color: var(--rev); }
.pill.insufficient_data { background: var(--warn-bg); color: var(--warn); }
.pill.pass_after_review { background: var(--ok-bg); color: var(--ok); }
.pill.not_testable { background: var(--na-bg); color: var(--na); }
.case.needs_review .stripe { background: var(--rev-strong); }
.case.pass_after_review .stripe { background: var(--ok-strong); }
.case.insufficient_data .stripe { background: var(--warn-strong); }
.case.needs_review > summary { background: var(--rev-bg); }
.case.insufficient_data > summary { background: var(--warn-bg); }
.cmd { display: flex; gap: 8px; align-items: stretch; flex-wrap: wrap; }
.cmd code { flex: 1 1 260px; font-family: var(--mono); font-size: .82rem; background: var(--soft); padding: 8px 10px; border-radius: 6px; overflow-wrap: anywhere; white-space: pre-wrap; }
.cmd button, .rbar button { font: inherit; font-size: .84rem; padding: 4px 12px; border-radius: 6px; border: 1px solid var(--rev-strong); background: var(--surface); color: var(--rev); cursor: pointer; }
.reviewed-line { font-size: .88rem; margin: 0; }
.tablewrap { overflow-x: auto; }
.rform { display: flex; flex-direction: column; gap: 10px; }
.ritem { border: 1px solid var(--line); background: var(--surface); border-radius: 8px; padding: 8px 10px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.ritem .id { font-family: var(--mono); font-size: .78rem; color: var(--muted); }
.ritem pre { margin: 0; white-space: pre-wrap; word-break: break-word; font-family: var(--sans); font-size: .88rem; background: var(--soft); padding: 6px 8px; border-radius: 6px; }
.rfields { display: flex; flex-wrap: wrap; gap: 8px 16px; }
.rfields label, .rnote { display: flex; flex-direction: column; gap: 2px; font-size: .84rem; }
.rnote { width: 100%; }
.rform input[type=text], .rform select, .rform textarea { font: inherit; font-size: .88rem; padding: 4px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--fg); }
.rbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.rstatus { font-size: .84rem; color: var(--muted); }
